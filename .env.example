# voicx environment variables sample.
# Copy to .env and adjust. All variables are prefixed with VOICX_ and override
# values in config.yaml. Nested keys use _ as a separator (e.g. VOICX_TCP_ADDR).

# SECURITY: this file selects a development stack. Before production set
# VOICX_DEV_MODE=false, set a strong non-empty VOICX_SERVER_PASSWORD, replace
# default database credentials with TLS-enabled production credentials, and
# keep both VOICX_TLS_ENABLED and VOICX_FILE_TLS_ENABLED true.
VOICX_SERVER_NAME=voicx
VOICX_SERVER_PASSWORD=  # DEVELOPMENT ONLY: production action: set a strong non-empty password
VOICX_LOG_LEVEL=info          # debug | info | warn | error
VOICX_DEV_MODE=true           # DEVELOPMENT ONLY: production action: false

VOICX_TCP_ADDR=:12333
VOICX_UDP_ADDR=:12334
VOICX_UDP_RATE_LIMIT_PPS=200
VOICX_UDP_RATE_BURST=400
VOICX_GRPC_ADDR=127.0.0.1:12338
VOICX_HEALTH_ADDR=:12337       # /dl bearer links are plaintext HTTP; bind loopback or proxy HTTPS
VOICX_METRICS_ALLOW_REMOTE=false
VOICX_PPROF_ENABLED=false      # disabled unless local runtime profiling is needed
VOICX_SHUTDOWN_TIMEOUT=30s     # shared grace period for orderly shutdown; must be positive
VOICX_QUERY_ADDR=127.0.0.1:12335
# Raw ServerQuery is plaintext. Set this true only together with an intentional
# non-loopback VOICX_QUERY_ADDR; prefer SSH for remote administration.
VOICX_QUERY_ALLOW_REMOTE=false
# ServerQuery over SSH (224): same commands and credentials as the raw port.
VOICX_QUERY_SSH_ENABLED=false
VOICX_QUERY_SSH_ADDR=:12339
VOICX_QUERY_SSH_HOST_KEY=./data/keys/query_ssh_host.key

# File transfer.
VOICX_FILE_ADDR=:12336
VOICX_FILE_ROOT=./data/files
VOICX_FILE_MAX_KBPS=0
VOICX_FILE_MAX_CONNECTIONS=128
VOICX_FILE_CHANNEL_QUOTA_MB=0
VOICX_FILE_MAX_SIZE_MB=100
VOICX_FILE_QUIET_HOURS_START=0
VOICX_FILE_QUIET_HOURS_END=0

# DEVELOPMENT ONLY: production action: unique credentials with sslmode=require,
# verify-ca, or verify-full; never use voicx:voicx in production.
VOICX_DATABASE_URL=postgres://voicx:voicx@localhost:5432/voicx?sslmode=disable
VOICX_PII_KEY_FILE=./data/keys/pii.key
VOICX_REDIS_ADDR=localhost:6379
VOICX_REDIS_PASSWORD=
VOICX_REDIS_ENABLED=true
VOICX_REDIS_DIAL_TIMEOUT=5s
VOICX_REDIS_READ_TIMEOUT=3s
VOICX_REDIS_WRITE_TIMEOUT=3s
VOICX_REDIS_TLS_ENABLED=false
VOICX_REDIS_TLS_SERVER_NAME=
VOICX_REDIS_TLS_CA_FILE=

VOICX_MAX_CLIENTS=1024
VOICX_CLIENT_TIMEOUT_SECONDS=90
VOICX_DEFAULT_OPUS_BITRATE=32000
VOICX_DEFAULT_OPUS_FEC=true
VOICX_DEFAULT_OPUS_DTX=false
VOICX_DEFAULT_OPUS_STEREO=false

# Echo test channel (empty = disabled). Publishers in it hear their own audio.
VOICX_ECHO_CHANNEL_NAME="Echo Test"
VOICX_CHANNEL_TEMP_LIFETIME_SECONDS=60

# TLS 1.3 for control and file transfer (default on). Cert/key empty =
# auto-generate a self-signed cert into VOICX_TLS_DIR on first start.
VOICX_TLS_ENABLED=true  # DEVELOPMENT ONLY false: production action: leave true
VOICX_TLS_DIR=./data/tls
VOICX_TLS_CERT_FILE=
VOICX_TLS_KEY_FILE=
VOICX_FILE_TLS_ENABLED=true  # DEVELOPMENT ONLY false: production action: leave true

# Chat payload encryption (wave 4b). Plaintext chat is rejected by default;
# true = dev escape hatch for old clients.
VOICX_CHAT_ALLOW_PLAINTEXT=false  # DEVELOPMENT ONLY true: production action: leave false
VOICX_CHAT_MASTER_KEY_FILE=./data/keys/chat_master.key
# Optional secret-injection override. VOICX_CHAT_MASTER_KEY takes precedence
# over VOICX_CHAT_MASTER_KEY_FILE and accepts either one base64 32-byte key or
# a newline-separated key ring of id:base64 entries. Inject it from a secret
# manager; do not commit it to this file.
VOICX_CHAT_MASTER_KEY=
VOICX_CHAT_LEGACY_HISTORY=encrypt
VOICX_CHAT_KEY_ROTATE_MIN_SECONDS=60
VOICX_CHAT_SEARCH_MAX_MESSAGES=2000
VOICX_SERVER_INFO_MOTD=false
VOICX_DEFAULT_GROUPS_ENABLED=true

# Chat moderation & limits (wave 5a).
VOICX_CHAT_MAX_LENGTH=4096
VOICX_CHAT_RATE_MSGS=5
VOICX_CHAT_RATE_WINDOW_SECONDS=3
VOICX_CHAT_WORD_FILTER=
VOICX_CHAT_LINK_BLACKLIST=
VOICX_CHAT_LINK_WHITELIST=

# TURN server for NAT traversal (445/446). Only needed behind restrictive
# NATs. VOICX_TURN_SECRET must match the coturn static-auth-secret (see the
# "turn" profile in docker-compose.yml); empty disables TURN.
# When running the dockerized coturn, set TURN_SECRET/TURN_REALM below to the
# SAME values: they configure coturn itself, and the two sides disagree
# silently if only one pair is filled in (445).
VOICX_TURN_SECRET=
VOICX_TURN_REALM=voicx
# Comma-separated TURN URIs handed to clients.
VOICX_TURN_URIS=
VOICX_TURN_CREDENTIALS_TTL=24h

# Database connection pool tuning.
VOICX_DB_MAX_OPEN_CONNS=25
VOICX_DB_MAX_IDLE_CONNS=5
VOICX_DB_CONN_MAX_LIFETIME=30m

# WebRTC (Pion) engine configuration.
# VOICX_WEBRTC_ICE_SERVERS is a comma-separated list of STUN/TURN URLs.
# If empty, the engine falls back to "stun:stun.l.google.com:19302".
VOICX_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
# Register the AV1 video codec (optional; not all clients support it).
VOICX_WEBRTC_ENABLE_AV1=false

# Server-side recording (ffmpeg subprocess). Nested list options
# (recording.video_args / audio_args) are YAML-only; use config.yaml to set
# hardware encoders such as -c:v h264_nvenc / h264_qsv / h264_vaapi.
VOICX_RECORDING_ENABLED=false
VOICX_RECORDING_DIR=recordings
VOICX_RECORDING_FFMPEG_PATH=ffmpeg
VOICX_RECORDING_FORMAT=webm

# ---------------------------------------------------------------------------
# Docker Compose credentials
# These are consumed by docker-compose.yml (not the VOICX_* app vars above).
# Copy .env.example to .env before running `make compose-up`. The values below
# deliberately select a host-local DEVELOPMENT stack. Replace the password and
# set VOICX_DEV_MODE=false before production use. Each secret accepts a plain
# value or its _FILE counterpart; set only one non-empty source. Files are read
# inside the container and are never passed as command-line arguments.
# Set each _FILE value to a readable host file. Prefer paths outside this
# repository: docker/secrets/.empty is only the checked-in empty bind fallback,
# and all other docker/secrets files are ignored from Git and Docker builds.
# On Linux, keep the host secret directory root-owned mode 0700 and each file
# root-owned mode 0444. Compose bind-mounts individual files (not the parent),
# so non-root containers can read only the files mounted into them while host
# users cannot traverse the source directory. Do not mount the whole directory.
# ---------------------------------------------------------------------------
POSTGRES_USER=voicx
POSTGRES_PASSWORD=voicx
POSTGRES_PASSWORD_FILE=
POSTGRES_DB=voicx
# Optional full database URL for Compose production deployments. Production
# mode accepts only sslmode=require, verify-ca, or verify-full.
VOICX_COMPOSE_DATABASE_URL=
VOICX_COMPOSE_DATABASE_URL_FILE=
# Used when Compose generates its internal PostgreSQL URL and by the backup
# container's PGSSLMODE. Keep disable only for the local development stack.
POSTGRES_SSLMODE=disable
REDIS_PASSWORD=
REDIS_PASSWORD_FILE=

# When VOICX_COMPOSE_DATABASE_URL or its _FILE form points to an external
# database, the backup profile fails closed until every setting below and one
# BACKUP_POSTGRES_PASSWORD source are set. These deliberately do not inherit
# the application URL, so pg_dump never receives a password-bearing URL.
BACKUP_PGHOST=
BACKUP_PGPORT=
BACKUP_PGUSER=
BACKUP_PGDATABASE=
BACKUP_PGSSLMODE=
BACKUP_POSTGRES_PASSWORD=
BACKUP_POSTGRES_PASSWORD_FILE=
# Optional libpq TLS files for external verify-ca/verify-full deployments.
BACKUP_PGSSLROOTCERT_FILE=
BACKUP_PGSSLCERT_FILE=
BACKUP_PGSSLKEY_FILE=
# rclone remote configuration is mounted only in the backup container.
RCLONE_CONFIG_FILE=
# Keep the scheduled profile resilient. One-shot use is documented below.
BACKUP_RESTART_POLICY=unless-stopped

# coturn ("turn" profile). TURN_SECRET/TURN_REALM configure the coturn
# container; they must equal VOICX_TURN_SECRET/VOICX_TURN_REALM above or
# coturn falls back to its placeholder secret while the server has TURN
# disabled — a silent mismatch (445).
TURN_SECRET=
TURN_SECRET_FILE=
TURN_REALM=voicx
# Public IP clients reach this host on. REQUIRED for anyone outside the host:
# without it coturn advertises relay candidates on its 172.x bridge address
# (445). Leave empty only for host-local testing.
TURN_EXTERNAL_IP=
